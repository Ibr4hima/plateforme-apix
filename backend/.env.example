# ── Assistant IA (API Claude / Anthropic) ────────────────────────────────────
# Clé API obtenue sur https://console.anthropic.com (côté serveur uniquement,
# jamais exposée au frontend). Laisser vide désactive l'assistant, et avec lui
# les noms complets proposés pour les entreprises tronquées par fDi et la
# lecture des captures (administration → fDi Markets).
# Sur la démo, ne rien écrire ici : la clé est le secret GitHub
# ANTHROPIC_API_KEY, et le modèle la variable ASSISTANT_MODELE ; le
# déploiement les pose dans ce fichier (scripts/deploy.sh).
ANTHROPIC_API_KEY=

# Réglages optionnels (valeurs par défaut dans app/core/config.py) :
# ASSISTANT_MODELE=claude-sonnet-5     # ou claude-opus-4-8 pour + de finesse
# ASSISTANT_MAX_TOKENS=1500            # plafond de sortie par réponse
# ASSISTANT_RATE_LIMIT=20              # requêtes par IP et par fenêtre
# ASSISTANT_RATE_FENETRE=3600          # fenêtre du rate-limit (secondes)
# FDI_PROPOSITIONS_MODELE=             # vide = le même modèle que l'assistant
# FDI_LECTURE_MODELE=                  # lecture des captures fDi ; vide = idem
