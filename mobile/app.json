{
  "expo": {
    "name": "APIX Sénégal",
    "slug": "apix-senegal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "sn.apix.plateforme",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sn.apix.plateforme",
      "adaptiveIcon": {
        "backgroundColor": "#004f91",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#004f91",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B1220"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b419e96f-fa4d-42bd-9d34-ecc3efbdb911"
      }
    }
  }
}
